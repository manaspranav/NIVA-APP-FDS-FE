{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/((?!maintenance\\.html).*)",
      "destination": "/maintenance.html",
      "permanent": false
    }
  ]
}
